{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      { "command": "node .cursor/hooks/metrics.mjs", "timeout": 5 }
    ],
    "postToolUse": [
      { "command": "node .cursor/hooks/metrics.mjs", "timeout": 5 }
    ],
    "postToolUseFailure": [
      { "command": "node .cursor/hooks/metrics.mjs", "timeout": 5 }
    ],
    "afterMCPExecution": [
      { "command": "node .cursor/hooks/metrics.mjs", "timeout": 5 }
    ],
    "subagentStop": [
      { "command": "node .cursor/hooks/metrics.mjs", "timeout": 5 }
    ],
    "stop": [
      { "command": "node .cursor/hooks/metrics.mjs", "timeout": 10 }
    ]
  }
}
